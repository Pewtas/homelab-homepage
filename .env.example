# DO NOT CHECK IN SENSITIVE INFORMATION IN THIS FILE
# This file is only for variable naming information
PUID= # User ID for the homepage container
PGID= # Group ID for the homepage container

HOMEPAGE_ALLOWED_HOSTS= # Comma-separated list of allowed hosts for the homepage (e.g., "localhost,example.com")

HOMEPAGE_VAR_FINNHUB_API_KEY= # API key for Finnhub stock data provider
HOMEPAGE_VAR_OPENWEATHERMAP_API_KEY= # API key for OpenWeatherMap (free tier at openweathermap.org)

HOMEPAGE_VAR_PROXMOX_USERNAME= # Proxmox API token ID, format: tokenid@pam!tokenname (Datacenter > Permissions > API Tokens)
HOMEPAGE_VAR_PROXMOX_PASSWORD= # Proxmox API token secret

HOMEPAGE_VAR_PROXMOXBACKUPSERVER_USERNAME # Proxmox API token ID, format: tokenid@pam!tokenname (Datacenter > Permissions > API Tokens)
HOMEPAGE_VAR_PROXMOXBACKUPSERVER_PASSWORD # Proxmox API token secret

HOMEPAGE_VAR_UNAS_USERNAME= # UNAS local account username (read-only role is enough)
HOMEPAGE_VAR_UNAS_PASSWORD= # UNAS local account password

HOMEPAGE_VAR_GCAL_ICS_URL_Tassi= # Calendar - Google Calendar "Secret address in iCal format" (Calendar Settings > Integrate calendar)
HOMEPAGE_VAR_GCAL_ICS_URL_Anna_Tassi=
HOMEPAGE_VAR_GCAL_ICS_URL_Arbeit_Tassi=
HOMEPAGE_VAR_GCAL_ICS_URL_Projects=
HOMEPAGE_VAR_GCAL_ICS_URL_Sport=
